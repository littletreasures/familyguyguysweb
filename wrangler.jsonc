{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "familyguyguysweb",
  "compatibility_date": "2026-07-10",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "PRERENDER_DATA_MODE=production npm run build:cf"
  },
  "env": {
    "preview": {
      "build": {
        "command": "PRERENDER_DATA_MODE=fixture npm run build:cf"
      }
    }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}